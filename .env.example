# Server Configuration
PORT=3000
NODE_ENV=development

# Database Path (defaults to ./database/patients.db)
DB_PATH=./database/patients.db

# Clinic Details (used in follow-up message personalization)
CLINIC_NAME="Apex Health & Wellness Clinic"
CLINIC_PHONE="+1 (555) 019-2831"

# AI Provider Configuration (Optional)
# If left blank, the system seamlessly uses the built-in Clinical Mock Engine.
# Provide your Gemini or OpenAI API key to test with live generative AI:
GEMINI_API_KEY=
OPENAI_API_KEY=
